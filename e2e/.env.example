# Deployed Plane instance under test (web + API share the origin on runway).
E2E_WEB_URL=https://silo.runway.plane.town
E2E_API_URL=https://silo.runway.plane.town

# Plane login used for the browser session and the app API (work-item creation, git-meta reads).
E2E_PLANE_EMAIL=
E2E_PLANE_PASSWORD=

# Workspace with the GitHub app installed + GIT_META flag on, and a project inside it.
E2E_GIT_META_WORKSPACE_SLUG=teams-test
E2E_GIT_META_PROJECT_ID=93a03995-9da1-4b13-90f4-d15cb8af2789
E2E_GIT_META_PROJECT_IDENTIFIER=GITMETAQA
# GitHub WorkspaceConnection id in that workspace (GET /silo/api/github/auth/organization-status/<workspaceId>).
E2E_GIT_META_WORKSPACE_CONNECTION_ID=353357cd-3482-4901-900c-825b92807f0c

# OAuth bearer token carrying the `git.meta` scope, or a workspace API key (plane_api_…, sent as
# X-API-Key) — needed for the seeded widget specs and the API specs
# (POST /api/v2/workspaces/<slug>/git-meta/). Leave empty to skip those.
E2E_GIT_META_TOKEN=

# Set to 1 to run the @known-bug cases (GM-07, GL-11) instead of skipping them, e.g. to record the failure.
E2E_RUN_KNOWN_BUGS=

# Live GitHub specs (webhook → silo → widget). PAT with contents + pull_requests write on the repo.
E2E_GITHUB_TOKEN=
E2E_GITHUB_REPO=Spvora/voralab
E2E_GITHUB_BASE=main
