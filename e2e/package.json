{
  "name": "voralab-git-meta-e2e",
  "private": true,
  "description": "Playwright end-to-end suite for Plane Git Meta (Development widget) against a deployed Plane instance",
  "scripts": {
    "test": "playwright test",
    "test:widget": "playwright test --grep @widget",
    "test:api": "playwright test --grep @api",
    "test:live": "playwright test --grep @live",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "check:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.11",
    "dotenv": "16.6.1",
    "typescript": "5.7.3"
  }
}
